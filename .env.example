# Copy to .env.local and set your own values
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password
SESSION_SECRET=a_long_random_secret_string

# SMTP for order notification emails (see lib/mailer.ts)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=smtp_password
MAIL_FROM="Protocol DMC <no-reply@example.com>"
# Where new booking notifications are sent (falls back to contact_email setting)
ORDER_NOTIFY_TO=admin@example.com
