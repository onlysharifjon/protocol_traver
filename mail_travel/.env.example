# mail_travel — Protocol DMC pochta serveri sozlamalari
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.

# --- Domen va host ---
# Asosiy pochta domeni (manzillar shu domende bo'ladi: user@protocoldmc.com)
MAIL_DOMAIN=protocoldmc.com
# Pochta serverining to'liq hostnomi (PTR/reverse DNS shunga mos bo'lishi kerak)
MAIL_HOSTNAME=mail.protocoldmc.com

# --- DKIM ---
# DKIM selektori (DNS yozuvida ishlatiladi: <selector>._domainkey.<domain>)
DKIM_SELECTOR=mail

# --- TLS sertifikati (Let's Encrypt) ---
# certbot olgan sertifikat yo'llari. MAIL_HOSTNAME uchun sertifikat olinadi.
TLS_CERT=/etc/letsencrypt/live/mail.protocoldmc.com/fullchain.pem
TLS_KEY=/etc/letsencrypt/live/mail.protocoldmc.com/privkey.pem

# --- Virtual mailbox saqlash joyi ---
VMAIL_DIR=/var/mail/vhosts

# ============================================================
# Sayt (Next.js) Nodemailer orqali SMTP bilan ulanishi uchun.
# Bu qiymatlarni loyihaning asosiy .env.local fayliga ham qo'shing.
# ============================================================
SMTP_HOST=mail.protocoldmc.com
# 587 = submission (STARTTLS), 465 = SMTPS (TLS)
SMTP_PORT=587
SMTP_SECURE=false
# Saytdan yuboriladigan xatlar uchun mailbox (setup paytida yaratiladi)
SMTP_USER=no-reply@protocoldmc.com
SMTP_PASS=
# Standart "From" sarlavhasi
MAIL_FROM="Protocol DMC <no-reply@protocoldmc.com>"
